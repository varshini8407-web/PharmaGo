<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/deliveryContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PharmaGo"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#176B4D"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/tvDeliveryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delivery Order Status"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#176B4D"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tvDeliveryDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fetching delivery details..."
                android:textSize="17sp"
                android:textColor="#202124"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="3dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Progress"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:elevation="3dp">

                <TextView
                    android:id="@+id/tvOrderConfirmed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○ Order Confirmed"
                    android:textSize="17sp"
                    android:paddingBottom="20dp" />

                <TextView
                    android:id="@+id/tvPreparing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○ Preparing Your Order"
                    android:textSize="17sp"
                    android:paddingBottom="20dp" />

                <TextView
                    android:id="@+id/tvOutForDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○ Out for Delivery"
                    android:textSize="17sp"
                    android:paddingBottom="20dp" />

                <TextView
                    android:id="@+id/tvDelivered"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○ Delivered"
                    android:textSize="17sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnDeliveryHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to Home"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:padding="14dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#176B4D"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone" />

    </RelativeLayout>
</ScrollView>